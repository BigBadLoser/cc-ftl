{
  "name": "cc-ftl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:quick": "VITEST_FAST=1 vitest run",
    "test:slow": "vitest run .slow.test",
    "test:soak": "VITEST_SOAK=1 vitest run .soak.test",
    "test:fast": "VITEST_FAST=1 vitest run --changed --passWithNoTests",
    "test:weights:ci": "node tools/testWeights.mjs --ci",
    "test:weights": "vitest run --reporter=json --outputFile=.vitest-report.json && node tools/testWeights.mjs .vitest-report.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p . & p=$!; svelte-check --tsconfig ./tsconfig.json; r=$?; wait $p; w=$?; [ $r = 0 ] && [ $w = 0 ]",
    "lab:build": "vite build -c spikes/crew-lab/vite.config.ts && node spikes/crew-lab/post.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:fast": "npm run lint && npm run typecheck && npm run test:fast",
    "shipgen": "node tools/shipgen/cli.js",
    "assets": "tools/blender/setup.sh && \"$(tools/blender/setup.sh)\" -b --factory-startup --python tools/blender/build.py",
    "assets:preview": "\"$(tools/blender/setup.sh)\" -b --factory-startup --python tools/blender/preview.py -- /tmp/claude-0/-home-user/ed10066a-51ba-5b6e-98cf-ce829905d359/scratchpad/assets-preview",
    "sprites": "\"$(tools/blender/setup.sh)\" -b --factory-startup --python tools/blender/sprites/build_sprites.py",
    "pixel-lab:build": "vite build -c spikes/pixel-lab/vite.config.ts && node spikes/pixel-lab/post.mjs",
    "lab": "node tools/lab/shoot.js",
    "profile": "node tools/profile/cli.js",
    "profile:sim": "node tools/profile/sim.js",
    "profile:windows": "node tools/profile/windows.js",
    "profile:dump": "node tools/profile/dump.js",
    "profile:baseline": "node tools/profile/baseline.js",
    "ai:diff": "node tools/profile/aiDiff.js"
  },
  "dependencies": {
    "@tabler/icons": "3.49.0",
    "bits-ui": "2.20.1",
    "pixi.js": "^8.9.2",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.71.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "cn": "^0.5.2",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "paneforge": "^1.0.2",
    "playwright-core": "^1.56.1",
    "shadcn-svelte": "^1.8.0",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5"
  }
}
