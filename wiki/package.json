{
  "name": "cc-ftl-wiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate && vite dev",
    "generate": "tsx scripts/extract-sprites.ts && tsx scripts/render-module-previews.ts && tsx scripts/generate-reference.ts",
    "build": "npm run generate && vite build",
    "check": "npm run generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@sveltepress/theme-default": "^8.11.0",
    "@sveltepress/vite": "^1.10.0",
    "@types/node": "^24.19.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.3",
    "sharp": "^0.34.5",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  }
}
