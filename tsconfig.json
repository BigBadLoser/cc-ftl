{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "svelte"],
    "paths": { "$lib": ["./tools/layout/lib"], "$lib/*": ["./tools/layout/lib/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts", "tools/profile/**/*.ts", "tools/lab/**/*.ts", "tools/layout/**/*.ts", "tools/layout/**/*.svelte"]
}
